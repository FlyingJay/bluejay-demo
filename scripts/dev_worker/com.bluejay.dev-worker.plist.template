<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for one dispatch worker. Generated by scripts/dev_worker/setup.sh
  from scripts/dev_worker/com.bluejay.dev-worker.plist.template; edit the
  template, not the copy in ~/Library/LaunchAgents.

  Runs poll_and_dispatch.sh every minute from this worker's dedicated clone
  (__CLONE__), which every run hard-resets to origin/main: never point it at
  a checkout you edit by hand.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CLONE__/scripts/firestore_admin/poll_and_dispatch.sh</string>
    <string>--worker</string>
    <string>__WORKER_KEY__</string>
  </array>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.__WORKER_KEY__.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.__WORKER_KEY__.err.log</string>
</dict>
</plist>
